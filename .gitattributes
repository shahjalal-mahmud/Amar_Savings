# Default: detect text/binary and normalize to LF
* text=auto eol=lf

# Force LF on source files (defensive)
*.kt        text eol=lf
*.kts       text eol=lf
*.java      text eol=lf
*.xml       text eol=lf
*.gradle    text eol=lf
*.toml      text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.properties text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Shell scripts: LF
*.sh        text eol=lf

# Windows batch files: keep CRLF so cmd.exe runs them correctly
*.bat       text eol=crlf
*.cmd       text eol=crlf
gradlew.bat text eol=crlf

# Binary assets
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.jar       binary
*.aar       binary
*.apk       binary
*.aab       binary
*.zip       binary
*.pdf       binary

# Never let line-ending normalization corrupt signing material
*.jks       binary
*.keystore  binary
*.p12       binary
*.pfx       binary

# Exclude generated/IDE directories from GitHub language statistics
/build/**           linguist-generated=true
/app/build/**       linguist-generated=true
/.gradle/**         linguist-generated=true
/.idea/**           linguist-generated=true
/.kotlin/**         linguist-generated=true
/local.properties   linguist-generated=true
